{
  "eqn_config": {
    "_comment": "Ex15 of SDE Stochastic Resonance",
    "eqn_name": "StochasticRes",
    "dim": 1,
    "dim_para": 1,
    "Delta": 0.1,
    "sigma": 0.25,
    "omega": 0.001,
    "V": 0.12,
    "resmodel_path": "./pretrainmodel/Ex1GeoBrownianm2s1/Best_model/checkpoint",
