      "base": 0.0001,
      "max": 0.0005,
      "step": 100,
      "gamma": 0.99
    },
    "l_rate_config_Stepcyclic": {
      "name": "StepCyclic",
      "base": 0.0001,
      "max": 0.0005,
      "step": 100,
      "gamma": 0.99,
      "scale": 0.5,
      "gstep": 10000
    },
    "l_rate_config_ROnPlat": {
      "name": "ReduceOnPlateau",
      "minr": 1e-05,
      "factor": 0.5,
      "patience": 100
    },
    "l_rate_config": {
      "name": "StepCyclic",
      "base": 0.0001,
      "max": 0.0003,
      "step": 10000,
      "gamma": 0.99999,
      "scale": 0.5,
      "gstep": 40000
    },
    "batch_size": 10000,
    "N_epochs": 200000,
    "Test_mode": "Normal"
  },
  "dat_config": {
    "TrainData_dir": "./data/Ex15StochasticRes/Ex15StochasticRes_Benzi1981_train.mat",
    "TestData_dir": "./data/Ex15StochasticRes/Ex15StochasticRes_Benzi1981_test.mat",
    "n_ea_traj": 2,
    "pair_data": true,
    "N_train_base": 10000,
    "N_pred": 200
  },
  "show_config": {
    "plot_samplecompare": true,
    "plot_meancompare": true,
    "plot_losthist": true
  },
  "monitor_config": {
    "repdf_display": {
      "if": false,
      "size": [
        8,
        8
      ],
      "range": [
        0.5,
        2
      ],
      "times": 20,
      "int_long": 0.5
    },
    "traindata_hist": true,
    "traintransin_hist": true,
    "cond_mv": {
      "if": false,
      "Npoint": 80,
      "range": [
        0.5,
        2
      ],
